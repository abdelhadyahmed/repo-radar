{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@repo-radar/ui": ["./packages/ui/src/index.ts"],
      "@repo-radar/types": ["./packages/types/src/index.ts"],
      "@repo-radar/store": ["./packages/store/src/index.ts"],
      "@repo-radar/github-repo": ["./packages/github-repo/src/index.ts"],
      "@repo-radar/plots": ["./packages/plots/src/index.ts"]
    }
  }
}
